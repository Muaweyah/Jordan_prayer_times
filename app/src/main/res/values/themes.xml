<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PrayerTimes" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <!-- الثيم البنفسجي: خلفية متدرجة وكتابة بيضاء عريضة واضحة -->
    <style name="Theme.PrayerTimes.Purple" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_gradient_start</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="android:windowBackground">@drawable/bg_gradient_purple</item>
        <item name="android:statusBarColor">@color/purple_gradient_start</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:textColorPrimary">@color/purple_text</item>
        <item name="android:textColorSecondary">@color/purple_text</item>
        <item name="android:textColor">@color/purple_text</item>
        <item name="android:textAppearanceLargePopupMenu">@style/PurplePopupMenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/PurplePopupMenuText</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenuPurple</item>
        <item name="popupMenuStyle">@style/AppPopupMenuPurple</item>
    </style>

    <!-- ستايل فاتح وواضح لنافذة اختيار الوقت (تذكيرات المهام)، بدل الستايل الداكن الافتراضي -->
    <style name="TasksTimePickerDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorAccent">#6750A4</item>
        <item name="android:textColorPrimary">#1C1B1F</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
