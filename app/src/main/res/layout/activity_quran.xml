<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/purple_dark_bg"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="القرآن الكريم"
        android:textColor="@color/purple_dark_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/spSurahList"
        android:popupBackground="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@color/purple_light_bg"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCurrentSurahName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/accent_gold"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="14dp"
        android:layout_marginBottom="16dp"
        android:text="" />

    <SeekBar
        android:id="@+id/seekBarQuran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTimeRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الوقت المتبقي: 00:00"
        android:textColor="@color/purple_dark_text"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnPlayQuran"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="تشغيل"
            android:backgroundTint="@color/accent_gold"
            android:textColor="#000000"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPauseQuran"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="إيقاف مؤقت"
            android:backgroundTint="#C0392B"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnRewind10"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="⏪ 10 ثوانٍ"
            android:backgroundTint="@color/purple_light_bg"
            android:textColor="@color/purple_light_text"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnForward10"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="10 ثوانٍ ⏩"
            android:backgroundTint="@color/purple_light_bg"
            android:textColor="@color/purple_light_text" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="نص السورة"
        android:textColor="@color/purple_dark_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/purple_light_bg"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvAyahText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/purple_light_text"
            android:textSize="18sp"
            android:lineSpacingExtra="10dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="" />

    </ScrollView>
</LinearLayout>

    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab_circle"
        android:src="@drawable/ic_home"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="الرئيسية" />

</FrameLayout>
