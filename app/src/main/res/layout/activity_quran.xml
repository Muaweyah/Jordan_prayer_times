<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/llQuranRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/purple_dark_bg"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tvQuranTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="القرآن الكريم"
        android:textColor="@color/purple_dark_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/spSurahList"
        android:popupBackground="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@color/purple_light_bg"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="صفحة المصحف"
        android:textColor="@color/purple_dark_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/purple_light_bg">

        <WebView
            android:id="@+id/webViewQuran"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressQuranPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <ImageButton
            android:id="@+id/btnToggleFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_fab_circle"
            android:src="@android:drawable/ic_menu_view"
            android:padding="8dp"
            android:contentDescription="شاشة كاملة" />

    </FrameLayout>
</LinearLayout>

    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab_circle"
        android:src="@drawable/ic_home"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="الرئيسية" />

</FrameLayout>
