<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/purple_dark_bg"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="القرآن الكريم"
        android:textColor="@color/purple_dark_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/spSurahList"
        android:popupBackground="@color/surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@color/purple_light_bg"
        android:layout_marginBottom="16dp" />

    <!-- صف تحكم موحّد: تأخير 10 ثوانٍ / تشغيل-إيقاف / شريط التقدّم / تقديم 10 ثوانٍ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnRewind10"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="⏪"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_light_bg"
            android:textColor="@color/purple_light_text" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="▶"
            android:textSize="18sp"
            android:backgroundTint="@color/accent_gold"
            android:textColor="#000000" />

        <SeekBar
            android:id="@+id/seekBarQuran"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnForward10"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:layout_marginStart="6dp"
            android:text="⏩"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_light_bg"
            android:textColor="@color/purple_light_text" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="صفحة المصحف"
        android:textColor="@color/purple_dark_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/purple_light_bg">

        <WebView
            android:id="@+id/webViewQuran"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressQuranPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>
</LinearLayout>

    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab_circle"
        android:src="@drawable/ic_home"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="الرئيسية" />

</FrameLayout>
