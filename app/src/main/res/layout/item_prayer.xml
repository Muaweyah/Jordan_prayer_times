<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_prayer_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    android:orientation="horizontal"
    android:layoutDirection="rtl"
    android:gravity="center_vertical"
    android:background="@drawable/bg_prayer_card_navy"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- أيقونة الصلاة بخلفية ملونة -->
    <ImageView
        android:contentDescription="Prayer Icon"
        android:id="@+id/iv_prayer_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="7dp"
        android:src="@drawable/ic_sun" />

    <!-- اسم الصلاة بالعربي -->
    <TextView
        android:id="@+id/tv_prayer_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/amiri_regular"
        android:textColor="@color/text_on_navy"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- الوقت وزر تفعيل التنبيه -->
    <TextView
        android:id="@+id/tv_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:textColor="@color/gold"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ImageButton
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Adhan Toggle Bell"
        android:id="@+id/btn_bell_toggle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:src="@drawable/ic_bell"
        app:tint="@color/gold" />
</LinearLayout>
