<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_prayer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1F2937">

    <!-- سطر واحد ثابت: الاسم الإنجليزي يسار، الوقت والجرس بالوسط، الاسم العربي والأيقونة يمين -->
    <LinearLayout
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- الاسم الإنجليزي: يسار البطاقة دائماً -->
        <TextView
            android:id="@+id/tv_prayer_name_en"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:textColor="#D1D5DB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- الوقت والجرس: منتصف البطاقة دائماً -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Adhan Toggle Bell"
                android:id="@+id/btn_bell_toggle"
                android:layout_height="32dp"
                android:layout_width="32dp"
                android:layout_marginEnd="8dp"
                android:padding="5dp"
                android:src="@drawable/ic_bell"
                app:tint="#F59E0B" />

            <TextView
                android:id="@+id/tv_prayer_time"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textColor="#F59E0B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الاسم العربي والأيقونة: يمين البطاقة دائماً -->
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/tv_prayer_name"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:contentDescription="Prayer Icon"
                android:id="@+id/iv_prayer_icon"
                android:layout_height="28dp"
                android:layout_width="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_sun" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
