<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_button_desc"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- صف اختيار المنطقة: الاسم والسهم على البداية، وسهم إضافي + زر الموقع على النهاية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <Spinner
            android:id="@+id/spRegion"
            android:popupBackground="@color/surface"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="52dp" />

        <ImageButton
            android:id="@+id/btnLocateMe"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_fab_circle"
            android:src="@android:drawable/ic_menu_mylocation"
            android:padding="8dp"
            android:contentDescription="تحديد الموقع تلقائياً" />
    </LinearLayout>

    <!-- بطاقة العد التنازلي: تاريخ بالأعلى، حلقة كبيرة بالوسط، اسم/وقت الصلاة القادمة بالأسفل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_countdown_card"
        android:padding="6dp"
        android:gravity="center"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvGregorianDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvHijriDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D8F3DC"
            android:textSize="12sp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="4dp"
            android:gravity="center" />

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="90dp">

            <com.jo.prayertimes.CircularCountdownView
                android:id="@+id/circularCountdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvRemainingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D8F3DC"
                    android:textSize="10sp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvCountdownBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvNextPrayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvNextPrayerClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="@color/countdown_text_secondary"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPrayerTimes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
