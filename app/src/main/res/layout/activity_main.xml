<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_navy_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="locale">

        <!-- شريط العنوان: زر القائمة + اسم التطبيق -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_button_desc"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/gold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:fontFamily="@font/font_amiri"
                android:textColor="@color/gold"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- التاريخ الميلادي والهجري -->
        <TextView
            android:id="@+id/tvGregorianDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_on_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHijriDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/gold_soft"
            android:textSize="12sp" />

        <!-- صف اختيار المنطقة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_region_pill"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp">

            <Spinner
                android:id="@+id/spRegion"
                android:popupBackground="@color/navy_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp" />

            <ImageButton
                android:id="@+id/btnLocateMe"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_location_pin"
                android:padding="4dp"
                android:contentDescription="تحديد الموقع تلقائياً" />
        </LinearLayout>

        <!-- بطاقة الصلاة القادمة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_next_prayer_gold_card"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvRemainingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_amiri"
                android:textColor="@color/gold_soft"
                android:textSize="12sp"
                android:layout_marginBottom="2dp"
                android:gravity="center" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="54dp">

                <com.jo.prayertimes.CircularCountdownView
                    android:id="@+id/circularCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvCountdownBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="00:00:00"
                    android:textColor="@color/text_on_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </FrameLayout>
        </LinearLayout>

        <!-- قائمة مواقيت اليوم -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPrayerTimes"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- تذييل: الوقت الحالي المباشر ونسبة لوزارة الأوقاف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/font_amiri"
                android:text="جدول أوقات الصلاة - الأردن"
                android:textColor="@color/text_on_navy_secondary"
                android:textSize="11sp"
                android:gravity="start" />

            <TextView
                android:id="@+id/tvFooterClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
