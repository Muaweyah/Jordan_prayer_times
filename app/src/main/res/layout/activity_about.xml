<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#F8F9FA"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حول التطبيق"
        android:textColor="#1B4332"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvAboutDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#333333"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnCloseAbout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="إغلاق"
        android:backgroundTint="#1B4332"
        android:textColor="#FFFFFF" />
</LinearLayout>

    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab_circle"
        android:src="@drawable/ic_home"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="الرئيسية" />

</FrameLayout>
