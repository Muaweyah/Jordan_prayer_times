<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- اسم الصلاة بالعربي (يمين) -->
        <TextView
            android:id="@+id/tvPrayerNameAr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1B4332"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="start" />

        <!-- وقت الصلاة (وسط) -->
        <TextView
            android:id="@+id/tvPrayerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2D6A4F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp" />

        <!-- اسم الصلاة بالإنكليزي (يسار) -->
        <TextView
            android:id="@+id/tvPrayerNameEn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#52B788"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
